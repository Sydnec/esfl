generator client {
  provider = "prisma-client-js"
  // Output local à l'app : évite que les services s'écrasent mutuellement
  // le client généré dans le store pnpm partagé.
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATA_DATABASE_URL")
}

model Competition {
  id           String    @id @default(cuid())
  pandascoreId Int       @unique @map("pandascore_id")
  gameId       String    @map("game_id")
  name         String
  slug         String?
  /** Tier Pandascore (s|a|b|c|d), dérivé des tournois de la série. */
  tier         String?
  beginAt      DateTime? @map("begin_at")
  endAt        DateTime? @map("end_at")
  imageUrl     String?   @map("image_url")
  /**
   * Compétition irrécupérable (aucune stat disponible chez les sources après la
   * fenêtre de récupération) : masquée du catalogue, du planning et du suivi
   * fantasy pour ne pas frustrer — personne ne la voit. Ré-évalué en continu :
   * repasse à false si des stats finissent par arriver.
   */
  hidden       Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  matches      Match[]
  teams        CompetitionTeam[]

  @@index([gameId])
  @@map("competitions")
}

model Team {
  id           String  @id @default(cuid())
  pandascoreId Int     @unique @map("pandascore_id")
  gameId       String  @map("game_id")
  name         String
  acronym      String?
  imageUrl     String? @map("image_url")
  /** Code pays ISO2 (drapeau). */
  location     String?
  /** Noms alternatifs chez les providers de stats (appris par corrélation adverse). */
  aliases      String[] @default([]) @map("aliases")
  /**
   * Identifiant de l'équipe chez chaque source spécialisée : { vlr: "1184",
   * leaguepedia: "T1", grid: "47369" }. Appris UNIQUEMENT depuis un match
   * résolu (les deux équipes reconnues) → fiable et persistant. Sert à taper
   * la bonne page équipe pour les rosters, sans recherche par nom (fragile).
   */
  providerIds  Json?   @map("provider_ids")
  /**
   * Champs possédés par un provider ({ name: "vlr", acronym: "vlr" }) :
   * le provider est source de vérité, Pandascore ne ré-écrase jamais un champ
   * listé ici (fallback uniquement). Null = tout appartient à Pandascore.
   */
  fieldSources Json?   @map("field_sources")
  /**
   * Date de référence du dernier roster appliqué (lineup d'un match ingéré ou
   * fetchStarters). Un backfill d'un vieux match n'écrase pas un roster plus
   * récent.
   */
  rosterSyncedAt DateTime? @map("roster_synced_at")
  players      Player[]
  competitions CompetitionTeam[]

  @@index([gameId])
  @@map("teams")
}

model CompetitionTeam {
  competitionId String      @map("competition_id")
  teamId        String      @map("team_id")
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([competitionId, teamId])
  @@map("competition_teams")
}

model Player {
  id           String  @id @default(cuid())
  /** Null pour les joueurs créés depuis une source de stats (VLR, Grid…). */
  pandascoreId Int?    @unique @map("pandascore_id")
  gameId       String  @map("game_id")
  /** Pseudo du joueur pro. */
  name         String
  /** Origine de la fiche : pandascore | vlr | grid | leaguepedia | octane | seed. */
  source       String  @default("pandascore")
  firstName    String? @map("first_name")
  lastName     String? @map("last_name")
  imageUrl     String? @map("image_url")
  role         String?
  /** Code pays ISO2 (drapeau). */
  nationality  String?
  teamId       String? @map("team_id")
  /**
   * Titulaire actuel de son équipe : seuls les joueurs du roster courant
   * Pandascore restent actifs. Les départs / remplaçants d'un seul match
   * passent à false et sortent des listes pickables (mais restent résolubles
   * pour l'historique, les fiches et les tops). Défaut true (rien masqué tant
   * qu'aucune réconciliation de roster n'a eu lieu).
   */
  active       Boolean @default(true)
  /**
   * Id du joueur chez chaque source ({ vlr: "7857" }), appris depuis un match
   * résolu. L'id numérique VLR survit aux renommages → matching fiable des
   * lignes de stats et des titulaires (au-delà du rapprochement par pseudo).
   */
  providerIds  Json?   @map("provider_ids")
  /**
   * Autres identités Pandascore de CE joueur, quand Pandascore lui-même le
   * dédouble (deux fiches pour la même personne). `pandascoreId` reste
   * l'identité principale ; celles-ci évitent de recréer un doublon chaque
   * fois qu'une identité secondaire remonte d'un roster.
   */
  pandascoreAliasIds Int[] @default([]) @map("pandascore_alias_ids")
  /** Champs possédés par un provider (cf. Team.fieldSources). */
  fieldSources Json?   @map("field_sources")
  team         Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  stats        PlayerMatchStats[]
  adoptionCandidate PlayerAdoptionCandidate?

  @@index([gameId])
  @@index([teamId])
  @@map("players")
}

/**
 * Rapprochement Pandascore ambigu, en attente d'un arbitrage humain. Plusieurs
 * joueurs Pandascore portent le même pseudo dans ce jeu : on ne devine pas
 * (même règle que le rapprochement d'équipe), la page admin tranche.
 */
model PlayerAdoptionCandidate {
  id String @id @default(cuid())
  /** Fiche locale orpheline concernée. */
  playerId String @unique @map("player_id")
  /** Candidats Pandascore : [{ id, name, teamName, role, realName, nationality }]. */
  candidates Json
  createdAt DateTime @default(now()) @map("created_at")
  /**
   * Cascade : sans elle, une purge des joueurs laisse des cas d'arbitrage
   * pointant vers des fiches disparues. Le panneau admin les ignore, mais la
   * table ment sur le travail restant.
   */
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_adoption_candidates")
}

model Match {
  id            String      @id @default(cuid())
  pandascoreId  Int         @unique @map("pandascore_id")
  gameId        String      @map("game_id")
  competitionId String      @map("competition_id")
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  name          String
  status        String // not_started | running | finished | canceled
  scheduledAt   DateTime?   @map("scheduled_at")
  beginAt       DateTime?   @map("begin_at")
  endAt         DateTime?   @map("end_at")
  teamAId       String?     @map("team_a_id")
  teamBId       String?     @map("team_b_id")
  scoreA        Int?        @map("score_a")
  scoreB        Int?        @map("score_b")
  winnerTeamId  String?     @map("winner_team_id")
  /** Gagné par forfait (adversaire absent) : pas de stats, vainqueur défini. */
  forfeit       Boolean     @default(false)
  /** Tournoi (phase) du match : poule/playoffs — pour l'affichage arbre/poules. */
  tournamentId   Int?    @map("tournament_id")
  tournamentName String? @map("tournament_name")
  /** Format du match (3 pour un BO3...). */
  bestOf        Int?        @map("best_of")
  /** Stream choisi : fr en priorité, sinon officiel. */
  streamUrl     String?     @map("stream_url")
  /** Manches : [{position, winner: 'A'|'B'|null}]. */
  gamesSummary  Json?       @map("games_summary")
  /** true une fois l'événement match.finished publié (idempotence). */
  finishedEventSent Boolean @default(false) @map("finished_event_sent")
  /** CS2 : la série est-elle référencée par Grid ? (null = pas encore vérifié) */
  gridCovered   Boolean?    @map("grid_covered")
  /** URL de la page de stats chez le provider (mémorisée au premier fetch). */
  statsPageUrl  String?     @map("stats_page_url")
  /**
   * Diagnostic du dernier échec d'ingestion des stats (effacé au succès) :
   * 'name-mismatch' = une équipe n'est pas reconnue par la source (vrai souci
   * de binding, à corriger via alias), 'no-coverage' = match absent de la
   * source. Sert à ne surfacer dans « à matcher » que les problèmes de nom.
   */
  statsFailureKind String? @map("stats_failure_kind")
  /** Noms candidats vus par la source (name-mismatch) : [{side, name}], pré-remplissage admin. */
  statsSuggestion  Json?   @map("stats_suggestion")
  /**
   * Snapshot des équipes au moment de l'ingestion des stats ({ name, acronym }) :
   * valeurs copiées (pas un lien), figées par match — un renommage ultérieur de
   * l'équipe ne réécrit pas l'histoire. Pas de logo (trop lourd dans le temps).
   */
  teamASnapshot Json?     @map("team_a_snapshot")
  teamBSnapshot Json?     @map("team_b_snapshot")
  stats         PlayerMatchStats[]

  @@index([competitionId])
  @@index([status])
  @@index([scheduledAt])
  @@map("matches")
}

model PlayerMatchStats {
  id         String   @id @default(cuid())
  matchId    String   @map("match_id")
  playerId   String   @map("player_id")
  gameId     String   @map("game_id")
  /** Provider d'origine : pandascore, grid, vlr, leaguepedia, octane, seed. */
  source     String
  raw        Json
  normalized Json
  /** Détail par manche (MapStatsEntry[]) quand la source le fournit. */
  perMap     Json?    @map("per_map")
  /** Pseudo du joueur au moment du match (snapshot, la fiche peut être renommée). */
  playerName String?  @map("player_name")
  /** Rôle joué sur CE match (LoL : Top|Jungle|Mid|Bot|Support), pas le rôle courant. */
  role       String?
  /** Côté du joueur dans le match : 'A' | 'B' (snapshot, survit aux transferts). */
  teamSide   String?  @map("team_side")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([playerId])
  @@map("player_match_stats")
}
