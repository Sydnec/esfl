generator client {
  provider = "prisma-client-js"
  // Output local à l'app : évite que les services s'écrasent mutuellement
  // le client généré dans le store pnpm partagé.
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATA_DATABASE_URL")
}

model Competition {
  id           String    @id @default(cuid())
  pandascoreId Int       @unique @map("pandascore_id")
  gameId       String    @map("game_id")
  name         String
  slug         String?
  tier         String?
  beginAt      DateTime? @map("begin_at")
  endAt        DateTime? @map("end_at")
  imageUrl     String?   @map("image_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  matches      Match[]
  teams        CompetitionTeam[]

  @@index([gameId])
  @@map("competitions")
}

model Team {
  id           String  @id @default(cuid())
  pandascoreId Int     @unique @map("pandascore_id")
  gameId       String  @map("game_id")
  name         String
  acronym      String?
  imageUrl     String? @map("image_url")
  /** Code pays ISO2 (drapeau). */
  location     String?
  /** Noms alternatifs chez les providers de stats (appris par corrélation adverse). */
  aliases      String[] @default([]) @map("aliases")
  players      Player[]
  competitions CompetitionTeam[]

  @@index([gameId])
  @@map("teams")
}

model CompetitionTeam {
  competitionId String      @map("competition_id")
  teamId        String      @map("team_id")
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([competitionId, teamId])
  @@map("competition_teams")
}

model Player {
  id           String  @id @default(cuid())
  /** Null pour les joueurs créés depuis une source de stats (VLR, Grid…). */
  pandascoreId Int?    @unique @map("pandascore_id")
  gameId       String  @map("game_id")
  /** Pseudo du joueur pro. */
  name         String
  /** Origine de la fiche : pandascore | vlr | grid | leaguepedia | octane | seed. */
  source       String  @default("pandascore")
  firstName    String? @map("first_name")
  lastName     String? @map("last_name")
  imageUrl     String? @map("image_url")
  role         String?
  /** Code pays ISO2 (drapeau). */
  nationality  String?
  teamId       String? @map("team_id")
  team         Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  stats        PlayerMatchStats[]

  @@index([gameId])
  @@index([teamId])
  @@map("players")
}

model Match {
  id            String      @id @default(cuid())
  pandascoreId  Int         @unique @map("pandascore_id")
  gameId        String      @map("game_id")
  competitionId String      @map("competition_id")
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  name          String
  status        String // not_started | running | finished | canceled
  scheduledAt   DateTime?   @map("scheduled_at")
  beginAt       DateTime?   @map("begin_at")
  endAt         DateTime?   @map("end_at")
  teamAId       String?     @map("team_a_id")
  teamBId       String?     @map("team_b_id")
  scoreA        Int?        @map("score_a")
  scoreB        Int?        @map("score_b")
  winnerTeamId  String?     @map("winner_team_id")
  /** Format du match (3 pour un BO3...). */
  bestOf        Int?        @map("best_of")
  /** Stream choisi : fr en priorité, sinon officiel. */
  streamUrl     String?     @map("stream_url")
  /** Manches : [{position, winner: 'A'|'B'|null}]. */
  gamesSummary  Json?       @map("games_summary")
  /** true une fois l'événement match.finished publié (idempotence). */
  finishedEventSent Boolean @default(false) @map("finished_event_sent")
  /** CS2 : la série est-elle référencée par Grid ? (null = pas encore vérifié) */
  gridCovered   Boolean?    @map("grid_covered")
  /** URL de la page de stats chez le provider (mémorisée au premier fetch). */
  statsPageUrl  String?     @map("stats_page_url")
  /**
   * Diagnostic du dernier échec d'ingestion des stats (effacé au succès) :
   * 'name-mismatch' = une équipe n'est pas reconnue par la source (vrai souci
   * de binding, à corriger via alias), 'no-coverage' = match absent de la
   * source. Sert à ne surfacer dans « à matcher » que les problèmes de nom.
   */
  statsFailureKind String? @map("stats_failure_kind")
  /** Noms candidats vus par la source (name-mismatch) : [{side, name}], pré-remplissage admin. */
  statsSuggestion  Json?   @map("stats_suggestion")
  stats         PlayerMatchStats[]

  @@index([competitionId])
  @@index([status])
  @@index([scheduledAt])
  @@map("matches")
}

model PlayerMatchStats {
  id         String   @id @default(cuid())
  matchId    String   @map("match_id")
  playerId   String   @map("player_id")
  gameId     String   @map("game_id")
  /** Provider d'origine : pandascore, grid, vlr, leaguepedia, octane, seed. */
  source     String
  raw        Json
  normalized Json
  /** Détail par manche (MapStatsEntry[]) quand la source le fournit. */
  perMap     Json?    @map("per_map")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([playerId])
  @@map("player_match_stats")
}
