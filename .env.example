# ── Base de données (un schéma par service) ───────────────────────
AUTH_DATABASE_URL=postgresql://esfl:esfl@localhost:5433/esfl?schema=auth
DATA_DATABASE_URL=postgresql://esfl:esfl@localhost:5433/esfl?schema=data
FANTASY_DATABASE_URL=postgresql://esfl:esfl@localhost:5433/esfl?schema=fantasy
SCORING_DATABASE_URL=postgresql://esfl:esfl@localhost:5433/esfl?schema=scoring

# ── Redis (cache + BullMQ) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ── Ports des services ─────────────────────────────────────────────
GATEWAY_PORT=4000
AUTH_SERVICE_PORT=4001
DATA_SERVICE_PORT=4002
FANTASY_SERVICE_PORT=4003
SCORING_SERVICE_PORT=4004

# ── URLs internes (réseau Docker en prod, localhost en dev) ───────
AUTH_SERVICE_URL=http://localhost:4001
DATA_SERVICE_URL=http://localhost:4002
FANTASY_SERVICE_URL=http://localhost:4003
SCORING_SERVICE_URL=http://localhost:4004

# ── Admin (routes de maintenance : sync, recompute) ───────────────
ADMIN_TOKEN=change-me-admin

# ── OAuth ──────────────────────────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_CALLBACK_BASE_URL=http://localhost:4000

# ── Sources de données ─────────────────────────────────────────────
PANDASCORE_TOKEN=
GRID_API_KEY=
# Stats RL — token gratuit à générer sur https://ballchasing.com/upload (login Steam)
BALLCHASING_API_KEY=
# Stats LoL — bot password Leaguepedia (Special:BotPasswords) : authentifie les
# requêtes Cargo → limite de lecture bien plus haute qu'en anonyme. Optionnel
# (sans, l'accès reste anonyme et fortement rate-limité). Format identifiant : Pseudo@nom
LEAGUEPEDIA_USERNAME=
LEAGUEPEDIA_BOT_PASSWORD=
# Horizon (jours) du rattrapage des stats publiées tardivement par les sources
# (Grid enregistre parfois un tournoi après la fenêtre de 48h). Optionnel, défaut 14.
STATS_BACKFILL_DAYS=
# Date de début du backfill historique lancé au premier démarrage (base vide) :
# catalogue + matchs + stats depuis cette date. Optionnel, défaut 2026-01-01.
HISTORY_BACKFILL_SINCE=

# ── Frontend ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Gel des journées de scoring : 0 = désactivé (à couper pendant une ré-ingestion massive)
SCORING_FREEZE_ENABLED=1
